# ============================================================
# OtterHub 环境变量模板（提交到 Git 的安全版本，不含真实值）
# 真实值记录在 .env.production.local（已 gitignore，仅本地保存）
# ============================================================

# ---------- 认证类 ----------
# 管理密码：网页登录 + WebDAV Basic 认证（必填）
PASSWORD=change-me

# API 令牌：Bearer 认证，可用于 WebDAV / 管理接口（必填）
API_TOKEN=change-me

# JWT 签名密钥（可选）：未配置时自动回落用 PASSWORD
JWT_SECRET=

# ---------- Telegram 存储（必填） ----------
TG_BOT_TOKEN=123456789:AAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TG_CHAT_ID=-1001234567890

# 多 Bot/多频道池（可选，防 Telegram 流控；未配置时仅用上面的单 bot）
# JSON 数组格式（推荐，Cloudflare Pages 环境变量直接粘贴）：
#   TG_BOT_POOLS=[{"token":"111:AAA","chatId":"-100xxx"},{"token":"222:BBB","chatId":"-100yyy"}]
# 或简化串格式：TG_BOT_POOLS=111:AAA|-100xxx,222:BBB|-100yyy
# 说明：
# - 槽位 0 为主槽位；未配置本变量时回退 TG_BOT_TOKEN/TG_CHAT_ID，行为与旧版一致
# - 上传自动轮询槽位（单文件按秒轮询、分片按序号轮询），429 流控自动换槽重试
# - file_id 与 bot 绑定：上传时会把槽位写入文件元数据，下载自动用对应 bot
# - 每个 bot 需是各自 chat 的管理员；webhook 需逐槽位绑定：
#     POST /telegram/webhook/setup          （槽位 0，兼容旧地址）
#     POST /telegram/webhook/1/setup        （槽位 1）
#     POST /telegram/webhook/2/setup        （槽位 2，以此类推）
# - 健康检查 GET /health 返回 tgPoolSize 可确认池规模
TG_BOT_POOLS=

# Webhook 回调密钥（可选）：启用"频道发文件自动入库"通道时必填
# 自己生成：openssl rand -hex 32（格式限制：1-256 字符，仅 A-Za-z0-9_-）
# 配置后需调 POST /telegram/webhook/setup 完成绑定
TG_WEBHOOK_SECRET=

# ---------- 自部署：Telegram API 代理（可选） ----------
# 国内服务器等无法直连 api.telegram.org 时，配置自建代理基址：
#   TG_API_BASE=https://cf.totootao.top/tg
# 代理端（otterhub-tg-proxy 项目）设置的鉴权令牌：
#   TG_PROXY_TOKEN=<代理端 TG_PROXY_TOKEN 的值>
# 两者均未配置时直连 api.telegram.org（默认，与原版一致）
TG_API_BASE=
TG_PROXY_TOKEN=

# ---------- 自托管 KV（可选） ----------
# 配置后元数据存储整体切换到自建服务，绕过 Cloudflare KV 每日写配额
# 未配置时使用 Cloudflare KV 绑定 oh_file_url
KV_ENDPOINT=
KV_AUTH_TOKEN=
KV_BASE_PATH=

# ---------- 本地开发 ----------
# npm run dev:backend 使用 wrangler 本地绑定：
#   PASSWORD=123456 API_TOKEN=123456
# KV（oh_file_url）与 R2（oh_file_r2）由 wrangler --kv/--r2 参数本地模拟
